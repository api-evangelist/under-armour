            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://www.mapmyfitness.com/v7.1/oauth2/authorize/",
              "accessTokenUrl": "https://api.ua.com/v7.1/oauth2/access_token/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
